{
  "name": "keyalesce",
  "version": "3.0.0",
  "author": {
    "name": "Tomer Aberbach",
    "email": "tomer@aberba.ch",
    "url": "https://tomeraberba.ch"
  },
  "description": "Get the same key for the same sequence of values!",
  "keywords": [
    "key",
    "key-value",
    "map",
    "idempotent",
    "multiple",
    "composite"
  ],
  "homepage": "https://github.com/TomerAberbach/keyalesce",
  "repository": "TomerAberbach/keyalesce",
  "bugs": {
    "url": "https://github.com/TomerAberbach/keyalesce/issues"
  },
  "funding": {
    "url": "https://github.com/sponsors/TomerAberbach"
  },
  "license": "Apache-2.0 AND MIT",
  "files": [
    "dist",
    "license-apache",
    "license-mit",
    "notice-apache"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">= 22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "format": "prettier --cache --write .",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ --fix .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "coverage": "vitest --coverage",
    "bench": "vitest bench",
    "build": "tsdown",
    "prepublishOnly": "pnpm build"
  },
  "prettier": "@tomer/prettier-config",
  "devDependencies": {
    "@fast-check/vitest": "^0.5.0",
    "@rollup/plugin-terser": "^1.0.2",
    "@tomer/eslint-config": "^6.0.0",
    "@tomer/prettier-config": "^5.0.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "jest-extended": "^7.0.0",
    "jsdom": "^31.0.0",
    "lfi": "^4.1.2",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
