{
  "name": "keyalesce",
  "version": "3.0.0",
  "author": {
    "name": "Tomer Aberbach",
    "email": "tomer@aberba.ch",
    "url": "https://tomeraberba.ch"
  },
  "description": "Get the same key for the same sequence of values!",
  "keywords": [
    "key",
    "key-value",
    "map",
    "idempotent",
    "multiple",
    "composite"
  ],
  "homepage": "https://github.com/TomerAberbach/keyalesce",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TomerAberbach/keyalesce.git"
  },
  "bugs": {
    "url": "https://github.com/TomerAberbach/keyalesce/issues"
  },
  "funding": {
    "url": "https://github.com/sponsors/TomerAberbach"
  },
  "license": "Apache-2.0 AND MIT",
  "files": [
    "dist",
    "license-apache",
    "license-mit",
    "notice-apache"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">= 22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "format:base": "prettier --cache --write",
    "format": "pnpm format:base .",
    "lint:base": "eslint --cache --cache-location node_modules/.cache/eslint/ --fix",
    "lint": "pnpm lint:base .",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "test": "vitest",
    "test:bun": "bun --bun node_modules/vitest/vitest.mjs",
    "test:deno": "deno run -A --v8-flags=--expose-gc node_modules/vitest/vitest.mjs",
    "coverage": "vitest --coverage",
    "build": "tsdown",
    "check": "npm-run-all -c -l -s build -p typecheck \"lint --no-fix\" \"format --no-write --check\" knip \"test --run\"",
    "prepublishOnly": "pnpm build"
  },
  "prettier": "@tomer/prettier-config",
  "devDependencies": {
    "@fast-check/vitest": "^0.5.0",
    "@rollup/plugin-terser": "^1.0.2",
    "@tomer/eslint-config": "^6.0.0",
    "@tomer/prettier-config": "^5.0.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "jest-extended": "^7.0.0",
    "knip": "^6.44.1",
    "lfi": "^4.1.2",
    "npm-run-all2": "^9.0.4",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "rollup-plugin-tree-shakeable": "^2.0.0",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
